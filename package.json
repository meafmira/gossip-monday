{
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "preview": "astro preview",
    "deploy": "bun run build && bunx gh-pages -d dist -b gh-pages -t --add",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seed:seedInitialData"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "astro": "6.2.1",
    "convex": "1.37.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.4",
    "oxlint": "0.15.0",
    "prettier": "3.4.2",
    "prettier-plugin-astro": "0.14.1"
  }
}
