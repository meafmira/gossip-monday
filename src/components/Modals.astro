---
import { members } from '../data/club';
---

<dialog class="modal" id="rsvp-modal">
  <form class="modal-card form-grid" id="rsvp-form" method="dialog">
    <div class="modal-head">
      <h2>RSVP на ланч</h2>
      <button class="close-btn" value="cancel" aria-label="Закрыть">×</button>
    </div>
    <label>Кто ты?
      <select name="member" required>
        {members.map((member) => <option value={member.id}>{member.name}</option>)}
      </select>
    </label>
    <label>Статус
      <select name="status" required>
        <option value="yes">Приду</option>
        <option value="maybe">Возможно, если переживу понедельник</option>
        <option value="no">Не приду</option>
      </select>
    </label>
    <label class="inline-check"><input type="checkbox" name="canLetIn" /> Могу пустить людей в офис</label>
    <label>Комментарий
      <textarea name="comment" placeholder="Например: приду, если встреча не станет митингом о встрече"></textarea>
    </label>
    <button class="btn hot" type="submit">Сохранить драматичный статус</button>
  </form>
</dialog>

<dialog class="modal" id="gossip-modal">
  <form class="modal-card form-grid" id="gossip-form" method="dialog">
    <div class="modal-head">
      <h2>Submit gossip</h2>
      <button class="close-btn" value="cancel" aria-label="Закрыть">×</button>
    </div>
    <label>Заголовок
      <input name="title" required placeholder="Та самая история, которую надо обсудить лично" />
    </label>
    <label>Автор
      <input name="author" placeholder="Можно оставить пустым и уйти в тень" />
    </label>
    <label class="inline-check"><input type="checkbox" name="anonymous" /> Анонимно, но с драмой</label>
    <button class="btn acid" type="submit">Добавить в backlog</button>
  </form>
</dialog>

<dialog class="modal" id="vacation-modal">
  <form class="modal-card form-grid" id="vacation-form" method="dialog">
    <div class="modal-head">
      <h2>Добавить отсутствие</h2>
      <button class="close-btn" value="cancel" aria-label="Закрыть">×</button>
    </div>
    <label>Участник
      <select name="member" required>
        {members.map((member) => <option value={member.id}>{member.name}</option>)}
      </select>
    </label>
    <div class="grid-2">
      <label>С
        <input name="from" type="date" required />
      </label>
      <label>По
        <input name="to" type="date" required />
      </label>
    </div>
    <label>Причина
      <select name="reason" required>
        <option>отпуск</option>
        <option>болею</option>
        <option>командировка</option>
        <option>удалёнка</option>
        <option>ментально отсутствую</option>
        <option>другое</option>
      </select>
    </label>
    <button class="btn hot" type="submit">Зафиксировать исчезновение</button>
  </form>
</dialog>

<dialog class="modal" id="join-modal">
  <form class="modal-card form-grid" method="dialog">
    <div class="modal-head">
      <h2>Application form</h2>
      <button class="close-btn" value="cancel" aria-label="Закрыть">×</button>
    </div>
    <label>Имя
      <input name="name" required placeholder="Как вас представлять комитету" />
    </label>
    <label>Кто пригласил
      <input name="invitedBy" required placeholder="Имя участника, который готов рискнуть репутацией" />
    </label>
    <label>Почему вы хотите вступить?
      <textarea name="reason" required placeholder="Опишите ваш опыт в наблюдении странных офисных ситуаций"></textarea>
    </label>
    <button class="btn acid" type="submit">Отправить заявку в void</button>
  </form>
</dialog>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр фото">
  <button class="lightbox-content" id="lightbox-content" type="button">Photo</button>
</div>
