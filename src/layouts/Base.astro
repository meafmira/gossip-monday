---
import '../styles/global.css';
import { base } from '../lib/base';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Onest:wght@400..900&family=Oswald:wght@500..700&display=swap';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load fonts without blocking first paint: fetch as `print`, then promote to `all`. -->
    <link rel="preload" as="style" href={fontsHref} />
    <link id="fonts-css" rel="stylesheet" href={fontsHref} media="print" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
    <script is:inline>
      (() => {
        const link = document.getElementById('fonts-css');
        if (!link) return;
        const promote = () => {
          link.media = 'all';
        };
        // `sheet` is set once the stylesheet has loaded (covers the cached case).
        if (link.sheet) promote();
        else link.addEventListener('load', promote, { once: true });
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="page-shell nav" aria-label="Главная навигация">
        <a class="logo" href={base} aria-label="Сплетни по понедельникам">
          <span class="logo-mark">🫖</span>
          <span>Сплетни по понедельникам</span>
        </a>
        <slot name="nav-links">
          <div class="nav-links">
            <a href={base}>На главную</a>
          </div>
        </slot>
      </nav>
    </header>

    <slot />

    <footer class="page-shell footer">
      <slot name="footer">
        <p>
          © 2026 Сплетни по понедельникам. Официально неофициально. Для тех, у кого есть ссылка.
        </p>
      </slot>
    </footer>
  </body>
</html>
