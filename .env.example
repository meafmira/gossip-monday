# Astro exposes only PUBLIC_ variables to browser code.
# For local development, run `bunx convex dev`, then copy CONVEX_URL from
# .env.local into PUBLIC_CONVEX_URL.
PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Created by `bunx convex dev` for local Convex commands.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# GitHub Actions secret only; do not commit a real deploy key.
CONVEX_DEPLOY_KEY=
